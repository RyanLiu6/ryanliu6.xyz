---
interface Props {
  pageName: string;
}

import { ClientRouter } from "astro:transitions";

import Header from "@/components/Header.tsx";
import Footer from "@/components/Footer.tsx";
import { bodyBorder, mainBorder } from "@ryanliu6/xi/styles";
import ThemeScript from "@ryanliu6/xi/ThemeScript.astro";

import "@/styles/base.css";

const { pageName } = Astro.props;
const nameWithName: string = pageName.trim() + " - Ryan Liu";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto" rel="stylesheet" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{nameWithName}</title>
    <ThemeScript />
  </head>
  <body class={bodyBorder}>
    <Header client:load />
    <main class={mainBorder}>
      <div class="flex flex-col flex-1 max-w-screen-md w-full">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
